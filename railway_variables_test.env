# ── PERFIL DE PRUEBA · pégalo en Railway → Variables → Raw Editor ─────────────────────────
# Empieza SOLO con señales: no toca BingX.
WEBHOOK_SECRET=PEGA_AQUI_UN_SECRETO_LARGO
TELEGRAM_BOT_TOKEN=PEGA_AQUI_EL_TOKEN_DE_BOTFATHER
TELEGRAM_CHAT_ID=PEGA_AQUI_TU_CHAT_ID

TRADING_MODE=signals
DATA_DIR=/data
DAILY_RESET_TZ=UTC

# Riesgo y filtros más estrictos que los de fábrica
ACCOUNT_SIZE=10000
RISK_PCT=0.5
MAX_TRADES_PER_DAY=2
MAX_LOSS_STREAK=2
MIN_RR=2.0
MAX_SLIPPAGE_PCT=0.10
ALLOWED_SYMBOLS=BTC-USDT,ETH-USDT

# Filtros nuevos
REQUIRE_DAILY_ALIGN=true      # no entra contra la estructura diaria
TRADE_HOURS_UTC=13-17         # solape Londres–Nueva York
SKIP_WEEKENDS=true
WEEKLY_REPORT=true            # informe los domingos a las 20:00 UTC (y /report cuando quieras)

# BingX: vacío hasta pasar a demo
BINGX_API_KEY=
BINGX_API_SECRET=
POSITION_MODE=hedge
MARGIN_TYPE=ISOLATED
LEVERAGE=3
MAX_LEVERAGE=3

NOTIFY_ABSORPTION=true
NOTIFY_SKIPS=true

# Escáner: solo las monedas más líquidas
SCAN_ENABLED=true
SCAN_INTERVAL_MIN=5
SCAN_TOP=15
SCAN_MIN_VOLUME=20000000
SCAN_ALERT_STAGE=4
SCAN_SUMMARY_MIN=60
